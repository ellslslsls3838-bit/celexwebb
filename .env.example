# Google Gemini (chat IA)
NEXT_PUBLIC_GEMINI_API_KEY=tu_api_key_aqui

# Spotify — https://developer.spotify.com/dashboard
# 1. Crea una app → Settings → Redirect URIs:
#    http://localhost:3000/callback
#    https://TU-DOMINIO.vercel.app/callback   (cuando despliegues)
# 2. Copia el Client ID (NO necesitas Client Secret con PKCE)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=tu_spotify_client_id
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/callback
